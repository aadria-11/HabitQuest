# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/habit_quest

# Auth (NextAuth v5)
AUTH_SECRET=your-secret-key-here-min-32-characters-long
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-min-32-characters-long

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# API
API_PORT=3001
INTERNAL_SECRET=internal-secret-min-32-characters

# Web (frontend)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
